# ==============================================================================
# Optical Shop Management CMS (optical-mgt)
# Root Apache Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Protect sensitive files and directories from direct browser access
<FilesMatch "\.(sql|env|json|log|md|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent access to dot files
<Files ".*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
